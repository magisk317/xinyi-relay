{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "forkProcessing": "enabled",
    "pruneStaleBranches": true,
    "pruneBranchAfterAutomerge": true,
    "minimumReleaseAge": "24 hours",
    "internalChecksFilter": "strict",
    "prCreation": "immediate",
    "baseBranchPatterns": [
        "beta"
    ],
    "ignoreDeps": [
        "rustls:rustls-platform-verifier",
        "org.matrix.rustcomponents:sdk-android"
    ],
    "packageRules": [
        {
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "automerge": true,
            "automergeType": "pr",
            "groupName": "other non-major dependencies",
            "groupSingleUpdates": false,
            "groupSlug": "all-minor-patch",
            "commitMessageExtra": "",
            "matchPackageNames": [
                "!/^androidx\\./",
                "!/^org\\.jetbrains\\.kotlin/",
                "!/^io\\.insert-koin\\./",
                "!/^org\\.junit\\./",
                "!/^dev\\.chrisbanes\\.haze/",
                "!/^com\\.squareup\\.okhttp3/",
                "!/^com\\.squareup\\.retrofit2/",
                "!/^io\\.ktor\\./",
                "!/^io\\.coil-kt/",
                "!/^io\\.kotest/",
                "!/^com\\.google\\.firebase/"
            ]
        },
        {
            "matchManagers": [
                "gradle",
                "maven"
            ],
            "addLabels": [
                "dependencies",
                "java"
            ]
        },
        {
            "matchManagers": [
                "npm",
                "pnpm"
            ],
            "addLabels": [
                "dependencies",
                "javascript"
            ]
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "addLabels": [
                "dependencies",
                "github_actions"
            ]
        },
        {
            "matchManagers": [
                "cargo"
            ],
            "addLabels": [
                "dependencies",
                "rust"
            ]
        },
        {
            "matchPackageNames": [
                "int:LOG_LEVEL",
                "int:MODULE_VERSION",
                "int:VERSION_CODE"
            ],
            "enabled": false
        },
        {
            "description": "The root Gradle force block is maintained by dependency-force-manager, not Renovate.",
            "matchManagers": [
                "gradle"
            ],
            "matchFileNames": [
                "build.gradle.kts"
            ],
            "enabled": false
        }
    ],
    "osvVulnerabilityAlerts": true,
    "vulnerabilityAlerts": {
        "enabled": true,
        "labels": ["security"]
    },
    "timezone": "Asia/Shanghai",
    "dependencyDashboard": true,
    "dependencyDashboardOSVVulnerabilitySummary": "all",
    "lockFileMaintenance": {
        "enabled": true,
        "automerge": true,
        "schedule": ["before 6am"]
    }
}
