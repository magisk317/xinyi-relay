# Backend 运行环境标识，常见值：development / production
RELAY_APP_ENV=development

# 可选：覆盖默认拉取的后端镜像；不填时使用 GHCR 的 beta 标签
RELAY_API_IMAGE=ghcr.io/magisk317/xinyi-relay-backend:beta

# 可选：控制 API 镜像拉取策略；部署默认 always，本地烟测可改为 never
RELAY_API_PULL_POLICY=always

# 后端 API 在容器内监听的地址和端口
RELAY_HTTP_ADDR=:8080

# 本地优先场景下，前端和 Android Agent 访问后端时使用的基础地址
RELAY_LOCAL_BASE_URL=https://localhost:8443

# 可选公网访问地址；没有公网入口时留空
RELAY_PUBLIC_BASE_URL=

# 允许跨域访问的前端来源地址
RELAY_CORS_ORIGIN=https://localhost:8443

# 后端连接 PostgreSQL 使用的 DSN
RELAY_DATABASE_URL=postgres://relay:relay@postgres:5432/relay?sslmode=disable

# 首次启动时自动初始化的管理员用户名
RELAY_ADMIN_USERNAME=relay

# 首次启动时自动初始化的管理员密码
RELAY_ADMIN_PASSWORD=relay-pass

# PostgreSQL 数据库名
POSTGRES_DB=relay

# PostgreSQL 登录用户名
POSTGRES_USER=relay

# PostgreSQL 登录密码
POSTGRES_PASSWORD=relay

# 反向代理签发证书和生成访问入口时使用的主机名或域名
RELAY_DOMAIN=localhost

# HTTP 调试入口监听主机；本地优先默认只监听 localhost
RELAY_HTTP_HOST=localhost

# 日志文件路径（留空则只输出到 stdout）
RELAY_LOG_FILE=

# 日志级别：debug, info, warn, error
RELAY_LOG_LEVEL=info

# 日志目录（Docker 部署时用于持久化日志）
RELAY_LOG_DIR=./logs
