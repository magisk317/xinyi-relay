# ⚠ 本文件中的口令/DSN 均为「本地开发默认值」，可直接用于本机 smoke / 联调。
# ⚠ 部署到生产前必须逐项替换为强随机值。当 RELAY_APP_ENV=production 时，
#    后端会拒绝以下不安全配置启动：CORS=*、弱 admin 口令、DSN sslmode=disable
#    （确需放行可设 RELAY_ALLOW_INSECURE=true，仅建议私网/可信网络场景）。

# Backend 运行环境标识，常见值：development / production
RELAY_APP_ENV=development

# 生产环境逃生阀：设为 true 可放行上述不安全配置检查（请谨慎使用）
RELAY_ALLOW_INSECURE=false

# 登录限流：同一 IP / 用户名在时间窗口内允许的最大失败尝试次数。
# 设为 0（或负数）即可整体关闭登录限流。
RELAY_LOGIN_RATE_LIMIT=10

# 登录限流时间窗口（Go duration 格式，如 5m、30s、1h）。
# 非法或非正值会被忽略并回退到默认 5m（并打印 warning）；关闭限流请用 RELAY_LOGIN_RATE_LIMIT=0。
RELAY_LOGIN_RATE_WINDOW=5m

# 是否信任反代设置的 X-Forwarded-For / X-Real-IP 头来识别客户端 IP（用于 IP 维度限流）。
# compose 默认把 API 直接映射到宿主机 8088，保持 false；只有部署在可信反代之后才改为 true，
# 否则客户端可伪造这些头绕过 IP 维度限流。
RELAY_TRUST_PROXY_HEADERS=false

# 记录保留（relay_records 清理）：每次设备上报入库后按用户裁剪，防止短信正文/验证码无限堆积。
# 默认跟随手机端的分类历史条数（验证码/纯短信/应用通知/来电通知，随 config 快照同步到后端）；
# 手机端某类设为 0/负数表示该类不限。设为 false 可关闭“跟随手机端”，仅用下方全局兜底。
RELAY_RECORDS_FOLLOW_DEVICE_LIMITS=true
# 可选：每用户记录总条数上限（跨所有类型）。0 表示关闭。
RELAY_RECORDS_MAX_PER_USER=0
# 可选：按天数保留，删除超过 N 天的记录。0 表示关闭。
RELAY_RECORDS_RETENTION_DAYS=0

# 可选：覆盖默认拉取的后端镜像；不填时使用 docker-compose.yml 里的 Docker Hub beta 标签
RELAY_API_IMAGE=docker.io/alpha317/xinyi-relay-backend:beta

# 可选：控制 API 镜像拉取策略；部署默认 always，本地烟测可改为 never
RELAY_API_PULL_POLICY=always

# 后端 API 在容器内监听的地址和端口
RELAY_HTTP_ADDR=:8080

# 本地优先场景下，前端和 Android Agent 访问后端时使用的基础地址
RELAY_LOCAL_BASE_URL=http://localhost:8088

# 可选公网访问地址；没有公网入口时留空
RELAY_PUBLIC_BASE_URL=

# 允许跨域访问的前端来源地址（生产请填精确来源，切勿用 *；* 无法与凭证请求共存）
RELAY_CORS_ORIGIN=http://localhost:8088

# 后端连接 PostgreSQL 使用的 DSN（本地为 sslmode=disable；生产请用 sslmode=require 或更强）
RELAY_DATABASE_URL=postgres://relay:relay@postgres:5432/relay?sslmode=disable

# 首次启动时自动初始化的管理员用户名
RELAY_ADMIN_USERNAME=relay

# 首次启动时自动初始化的管理员密码（⚠ 生产必须改为强随机值，relay-pass 等弱口令会被拒绝启动）
RELAY_ADMIN_PASSWORD=relay-pass

# PostgreSQL 数据库名
POSTGRES_DB=relay

# PostgreSQL 登录用户名
POSTGRES_USER=relay

# PostgreSQL 登录密码（⚠ 生产必须改为强随机值，并与 RELAY_DATABASE_URL 中保持一致）
POSTGRES_PASSWORD=relay

# 日志文件路径（留空则只输出到 stdout）
RELAY_LOG_FILE=

# 日志级别：debug, info, warn, error
RELAY_LOG_LEVEL=info

# 日志目录（Docker 部署时用于持久化日志）
RELAY_LOG_DIR=./logs
