{
	default_sni {$RELAY_DOMAIN}
}

(relay_routes) {
	@backend_api {
		path /healthz /api/*
	}

	handle @backend_api {
		reverse_proxy api:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

https://{$RELAY_DOMAIN}:8443 {
	tls internal {
		curves x25519 secp256r1
		key_type rsa2048
	}
	encode gzip zstd
	import relay_routes
}

http://:8088 {
	bind {$RELAY_HTTP_HOST}
	encode gzip zstd
	import relay_routes
}
