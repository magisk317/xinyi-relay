{
  "name": "xinyi-relay-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "./scripts/with-system-pkg-config.sh cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri:dev": "./scripts/with-system-pkg-config.sh tauri dev",
    "tauri:build": "./scripts/with-system-pkg-config.sh tauri build",
    "tauri:check:linux": "./scripts/with-system-pkg-config.sh cargo check --manifest-path src-tauri/Cargo.toml",
    "desktop:test": "npm run test && npm run test:rust",
    "desktop:ci": "npm run build && npm run desktop:test && npm run tauri:check:linux",
    "desktop:check": "npm run desktop:ci"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.10.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@tauri-apps/api": "2.10.1",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@tauri-apps/plugin-shell": "2.3.5",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.1.1"
  }
}
