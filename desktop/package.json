{
  "name": "xinyi-relay-desktop",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons:generate": "pnpm exec tauri icon src-tauri/icons/icon.png --output src-tauri/icons",
    "test:rust": "node ./scripts/with-system-pkg-config.mjs cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri:dev": "node ./scripts/with-system-pkg-config.mjs tauri dev",
    "tauri:build": "node ./scripts/with-system-pkg-config.mjs tauri build",
    "tauri:check:linux": "node ./scripts/with-system-pkg-config.mjs cargo check --manifest-path src-tauri/Cargo.toml",
    "desktop:test": "pnpm test && pnpm test:rust",
    "desktop:ci": "pnpm build && pnpm desktop:test && pnpm tauri:check:linux",
    "desktop:check": "pnpm desktop:ci"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.2",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^29.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.1",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@tauri-apps/plugin-shell": "2.3.5",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.1.1"
  }
}
