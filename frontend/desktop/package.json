{
  "name": "xinyi-relay-desktop",
  "private": true,
  "version": "0.2.4",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons:generate": "bunx tauri icon src-tauri/icons/icon.png --output src-tauri/icons",
    "test:rust": "node ./scripts/with-system-pkg-config.mjs cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri:dev": "node ./scripts/with-system-pkg-config.mjs tauri dev",
    "tauri:build": "node ./scripts/with-system-pkg-config.mjs tauri build",
    "tauri:check:linux": "node ./scripts/with-system-pkg-config.mjs cargo check --manifest-path src-tauri/Cargo.toml",
    "desktop:test": "bun test && bun run test:rust",
    "desktop:ci": "bun run build && bun run desktop:test && bun run tauri:check:linux",
    "desktop:check": "bun run desktop:ci"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^30.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.0.1",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-notification": "2.4.0",
    "@tauri-apps/plugin-shell": "2.3.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.1.1"
  }
}
